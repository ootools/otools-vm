{
  "name": "otools-vm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "OTools VM — 基于 Apple Virtualization.framework 的桌面虚拟机插件，支持 Windows / Linux 图形虚拟机、共享目录、剪贴板与窗口自适应分辨率。",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 6162",
    "build": "vite build",
    "build:check": "vue-tsc --noEmit --pretty false && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5162",
    "pack": "node scripts/pack-plugin.mjs",
    "verify": "node scripts/verify-plugin.mjs",
    "release": "node scripts/pack-plugin.mjs && node scripts/verify-plugin.mjs",
    "smoke": "python3 scripts/smoke-native.py"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "element-plus": "^2.8.5",
    "vue": "^3.5.12"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@unocss/preset-uno": "^66.6.0",
    "@unocss/vite": "^66.6.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "unocss": "^66.6.0",
    "vite": "^6.0.1",
    "vue-tsc": "^2.1.10"
  }
}
