{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "preserve",
    "sourceMap": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "otools-plugin-sdk/dialog": [
        "../otools/vendor/otools-plugin-sdk/src/dialog.ts",
        "vendor/otools-plugin-sdk/src/dialog.ts"
      ],
      "otools-plugin-sdk/host-file-tree": [
        "../otools/vendor/otools-plugin-sdk/src/host-file-tree.ts",
        "vendor/otools-plugin-sdk/src/host-file-tree.ts"
      ]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue", "vite.config.ts"]
}
